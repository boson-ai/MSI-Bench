# Copy this file to .env (same directory) and fill in the keys you need.
# Only the providers you evaluate against are required.

OPENAI_API_KEY=sk-...          # gpt-audio / gpt-realtime targets + openai judge
GEMINI_API_KEY=...             # gemini targets (install extra: msi-bench-eval[gemini])
OPENROUTER_API_KEY=sk-or-...   # answer-judge via openrouter
