# Slurm serving contract for one ib eval local model job.
# Sourced by slurm/ib_eval_local.sbatch; GPUS/CPUS/MEM/TIME read by slurm/submit.sh.
IMAGE=/ceph/enroot_images/eval-runner-vllm-omni-20260421.sqsh
CONFIG_DIR=serve/configs/mimo-audio
CONFIG_FILE=vllm-omni.yaml
MODEL_PATH=/models/MiMo-Audio-7B-Instruct
TP=1
GPUS=1
CPUS=16
MEM=120G
TIME=24:00:00
OMNI=1
CONTAINER_ENV="MIMO_AUDIO_TOKENIZER_PATH=/models/MiMo-Audio-Tokenizer"
VLLM_EXTRA_ARGS=""
